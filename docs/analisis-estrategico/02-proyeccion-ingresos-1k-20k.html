    --surface: #0e1422;
    --surface-2: #141d30;
    --border: #1f2d48;
    --text: #e5ecff;
    --muted: #7b8fb5;
    --accent: #3dc3ff;
    --accent-lo: rgba(61,195,255,0.10);
    --success: #4ade80;
    --success-lo: rgba(74,222,128,0.09);
    --warn: #fbbf24;
    --warn-lo: rgba(251,191,36,0.09);
  }
}
:root[data-theme="dark"] {
  --bg: #060910;
  --surface: #0e1422;
  --surface-2: #141d30;
  --border: #1f2d48;
  --text: #e5ecff;
  --muted: #7b8fb5;
  --accent: #3dc3ff;
  --accent-lo: rgba(61,195,255,0.10);
  --success: #4ade80;
  --success-lo: rgba(74,222,128,0.09);
  --warn: #fbbf24;
  --warn-lo: rgba(251,191,36,0.09);
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: var(--body);
  background: var(--bg);
  color: var(--text);
  font-size: 15px;
  line-height: 1.6;
  padding-inline: 20px;
  padding-block: 44px 96px;
}
.doc { max-width: 900px; margin: 0 auto; }

/* ── Header ── */
.eyebrow {
  font-family: var(--mono);
  font-size: 11px;
  color: var(--accent);
  letter-spacing: .12em;
  text-transform: uppercase;
  margin-bottom: 12px;
}
.header h1 {
  font-family: var(--display);
  font-size: clamp(26px, 5vw, 46px);
  font-weight: 800;
  letter-spacing: -.025em;
  line-height: 1.06;
  margin-bottom: 14px;
  text-wrap: balance;
}
.header h1 em { font-style: normal; color: var(--accent); }
.header-sub { font-size: 14px; color: var(--muted); max-width: 540px; line-height: 1.55; margin-bottom: 36px; }

/* ── Hero stat ── */
.hero-stat {
  display: flex;
  align-items: flex-end;
  gap: 28px;
  flex-wrap: wrap;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 28px 32px;
  margin-bottom: 40px;
}
.hero-main {}
.hero-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .09em; color: var(--muted); margin-bottom: 6px; }
.hero-number {
  font-family: var(--mono);
  font-size: clamp(44px, 8vw, 72px);
  font-weight: 600;
  color: var(--success);
  line-height: 1;
}
.hero-sub { font-size: 13px; color: var(--muted); margin-top: 6px; }
.hero-breakdown {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding-bottom: 4px;
}
.hb-row { display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--muted); }
.dot { width: 10px; height: 10px; border-radius: 3px; flex-shrink: 0; }
.dot-blue { background: var(--accent); }
.dot-amber { background: var(--warn); }
.dot-green { background: var(--success); }
.hb-val { font-family: var(--mono); font-size: 13px; color: var(--text); margin-left: auto; }

/* ── Assumptions ── */
.chips { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 36px; }
.chip {
  display: inline-flex; align-items: center; gap: 6px;
  background: var(--surface); border: 1px solid var(--border);
  border-radius: 6px; padding: 4px 11px;
  font-size: 11.5px; color: var(--muted);
}
.chip strong { font-family: var(--mono); font-size: 11px; color: var(--text); font-weight: 500; }

/* ── Main projection table ── */
h2 {
  font-family: var(--display);
  font-size: clamp(18px, 3vw, 24px);
  font-weight: 700;
  letter-spacing: -.015em;
  margin-bottom: 16px;
  text-wrap: balance;
}

.proj-wrap { overflow-x: auto; margin-bottom: 44px; }

.proj-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  border: 1px solid var(--border);
  border-radius: 14px;
  overflow: hidden;
  font-variant-numeric: tabular-nums;
  min-width: 640px;
}

.proj-table thead th {
  background: var(--surface-2);
  padding: 10px 14px;
  text-align: right;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .08em;
  color: var(--muted);
  border-bottom: 1px solid var(--border);
  white-space: nowrap;
}
.proj-table thead th:first-child { text-align: left; }
.proj-table thead th.net-h { color: var(--success); }

.proj-table tbody td {
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  padding: 14px 14px;
  vertical-align: middle;
  font-family: var(--mono);
  font-size: 12.5px;
  text-align: right;
  color: var(--muted);
}
.proj-table tbody tr:nth-child(even) td { background: var(--surface-2); }
.proj-table tbody tr:last-child td { border-bottom: none; }
.proj-table tbody tr.peak td { background: var(--accent-lo); }

.proj-table td:first-child { text-align: left; }

/* Users cell */
.users-cell { display: flex; flex-direction: column; gap: 2px; }
.users-big { font-family: var(--mono); font-size: 18px; font-weight: 600; color: var(--text); line-height: 1; }
.peak .users-big { color: var(--accent); }
.users-sub { font-size: 10.5px; color: var(--muted); font-family: var(--body); }

/* Stacked bar */
.stack-bar { display: flex; height: 6px; border-radius: 3px; overflow: hidden; gap: 1px; margin-top: 6px; width: 100px; }
.sb-subs { background: var(--accent); }
.sb-certs { background: var(--warn); }
.sb-boots { background: var(--success); }

/* Stream cols */
.col-subs  { color: var(--accent) !important; }
.col-certs { color: var(--warn) !important; }
.col-boots { color: var(--success) !important; }
.col-gross { color: var(--text) !important; font-weight: 500; }

/* Net cell */
.net-cell { display: flex; flex-direction: column; align-items: flex-end; gap: 1px; }
.net-mo { font-family: var(--mono); font-size: 18px; font-weight: 600; color: var(--success); line-height: 1; }
.peak .net-mo { color: var(--accent); }
.net-yr { font-family: var(--mono); font-size: 11px; color: var(--muted); }

/* ── Summary cards ── */
.summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin-bottom: 44px; }
.sum-card {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: 12px; padding: 16px; text-align: center;
}
.sum-card.peak { border-color: var(--accent); background: var(--accent-lo); }
.sum-tier { font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); margin-bottom: 8px; }
.sum-net { font-family: var(--mono); font-size: clamp(16px, 2.5vw, 22px); font-weight: 600; color: var(--success); line-height: 1; margin-bottom: 3px; }
.sum-card.peak .sum-net { color: var(--accent); }
.sum-yr { font-family: var(--mono); font-size: 10.5px; color: var(--muted); }

/* ── Bootcamp readiness ── */
.boot-section {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  overflow: hidden;
  margin-bottom: 40px;
}
.boot-header {
  display: flex; align-items: center; gap: 12px;
  padding: 14px 20px;
  background: var(--surface-2);
  border-bottom: 1px solid var(--border);
}
.boot-title { font-family: var(--display); font-size: 15px; font-weight: 700; }
.boot-badge {
  margin-left: auto;
  font-family: var(--mono); font-size: 10px; font-weight: 600;
  text-transform: uppercase; letter-spacing: .08em;
  padding: 3px 9px; border-radius: 4px;
}
.badge-partial { background: var(--warn-lo); color: var(--warn); }

.boot-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
}
@media (max-width: 560px) { .boot-grid { grid-template-columns: 1fr; } }

.boot-col { padding: 18px 20px; }
.boot-col:first-child { border-right: 1px solid var(--border); }
@media (max-width: 560px) { .boot-col:first-child { border-right: none; border-bottom: 1px solid var(--border); } }

.boot-col-title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); margin-bottom: 12px; }

.check-list { display: flex; flex-direction: column; gap: 7px; }
.check-item { display: flex; align-items: flex-start; gap: 10px; font-size: 13px; }
.check-icon { flex-shrink: 0; width: 16px; text-align: center; margin-top: 1px; }
.check-text { line-height: 1.4; color: var(--text); }
.check-sub { font-size: 11px; color: var(--muted); margin-top: 1px; }

/* ── Callout ── */
.callout {
  padding: 14px 18px;
  border-left: 3px solid var(--accent);
  background: var(--accent-lo);
  border-radius: 0 8px 8px 0;
  font-size: 14px;
  line-height: 1.6;
  margin-bottom: 16px;
}
.callout.warn { border-color: var(--warn); background: var(--warn-lo); }
.callout strong { color: var(--accent); }
.callout.warn strong { color: var(--warn); }

.note { font-size: 12px; color: var(--muted); line-height: 1.55; }

/* ── Legend ── */
.legend { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 16px; }
.leg-item { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--muted); }
.leg-dot { width: 10px; height: 10px; border-radius: 3px; flex-shrink: 0; }
</style>

