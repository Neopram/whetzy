  --accent: #1CB0F6;
  --accent-lo: rgba(28,176,246,0.10);
  --success: #16a34a;
  --success-lo: rgba(22,163,74,0.09);
  --warn: #b45309;
  --warn-lo: rgba(180,83,9,0.09);
