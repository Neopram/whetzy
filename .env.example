# Whetzy — environment template. Copy to backend/.env and fill in real values.
# NEVER commit the real .env.

# Strong random secret (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`). REQUIRED in production.
SECRET_KEY=change-me-to-a-64-char-random-hex-string

# Postgres password used by docker-compose.
POSTGRES_PASSWORD=change-me

# development | staging | production
ENVIRONMENT=production

# Comma-separated allowed origins for the frontend.
BACKEND_CORS_ORIGINS=https://whetzy.com,https://www.whetzy.com,https://*.pages.dev,http://localhost:5173

# AI tutor. Leave empty to use the grounded fallback; set to enable the real LLM tutor.
# Get a free key at https://console.groq.com — use model qwen/qwen3.8-27b
GROQ_API_KEY=

# RAG needs no configuration. Since 11.1 it is a pure-Python BM25 index built
# from the database at startup (~0.6s, ~17MB) — no ChromaDB, no
# sentence-transformers, no torch, nothing to persist. The old
# CHROMA_PERSIST_PATH variable is gone; delete it if you still have it set.
