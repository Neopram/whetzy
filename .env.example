# Whetzy — environment template. Copy to backend/.env and fill in real values.
# NEVER commit the real .env.

# Strong random secret (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`). REQUIRED in production.
SECRET_KEY=change-me-to-a-64-char-random-hex-string

# Postgres password used by docker-compose.
POSTGRES_PASSWORD=change-me

# development | staging | production
ENVIRONMENT=production

# Comma-separated allowed origins for the frontend.
BACKEND_CORS_ORIGINS=https://whetzy.com,https://www.whetzy.com,https://whetzy.pages.dev,https://app.whetzy.com,capacitor://app.whetzy.com,http://localhost:5173

# AI tutor. Leave empty to use the grounded fallback; set to enable the real LLM tutor.
# Get a free key at https://console.groq.com — use model qwen/qwen3.8-27b
GROQ_API_KEY=

# RAG needs no configuration. Since 11.1 it is a pure-Python BM25 index built
# from the database at startup (~0.6s, ~17MB) — no ChromaDB, no
# sentence-transformers, no torch, nothing to persist. The old
# CHROMA_PERSIST_PATH variable is gone; delete it if you still have it set.

# Paddle (H.29 - Merchant of Record for instructor payouts and subscriptions)
# Get credentials from https://dashboard.paddle.com/
PADDLE_API_KEY=pdl_live_apikey_xxxxxxxxxxxxx
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxxxxxxxxxxxx
PADDLE_VENDOR_ID=your_vendor_id
PADDLE_TAX_ID=your_tax_id_grecia
# Paddle Billing (pago web). "sandbox" o "production" (la cuenta live usa production).
PADDLE_ENVIRONMENT=sandbox
# Público: token de cliente de Paddle.js (Developer tools > Authentication > Client-side tokens)
PADDLE_CLIENT_TOKEN=
# Ids de precio pri_... : Pro 14,99 $/mes, Pro Max 19,99 $/mes, certificación 39,99 $ pago único
PADDLE_PRICE_PLUS=
PADDLE_PRICE_PRO=
PADDLE_PRICE_CERTIFICATION=

# Cuenta de dueño (rol owner, acceso a /admin). Las dos o ninguna; la contraseña
# solo en las variables del entorno (Railway), nunca en el repo. Ver RUNBOOK.
OWNER_EMAIL=
OWNER_PASSWORD=

# Correos de marketing programados (apagados por defecto; los enciende el dueño).
# 39.13: oferta de reactivación. 26.10: newsletter mensual a suscritos confirmados.
REACTIVATION_EMAILS_ENABLED=false
NEWSLETTER_MONTHLY_ENABLED=false
