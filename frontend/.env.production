# Origen de la API en produccion. Vive aqui, commiteado, porque no es un
# secreto —es una URL publica— y porque la alternativa era que dependiera
# de que quien despliega se acordara de exportarla. No se acordo, y el
# build salio apuntando a '/api/v1' del propio dominio: Cloudflare
# respondia a eso con el index.html y un 200, asi que la aplicacion
# entera se quedo sin backend sin un solo error en consola.
#
# 2026-09-24: se cambio a whetzy-production.up.railway.app, que responde
# «Application not found» (404), y el bundle desplegado acabo con
# 'https://whetzy.com' como API: el login iba a Cloudflare y devolvia 405.
# El backend vivo es este (GET /health → 200, CORS permite whetzy.com).
#
# 2026-10-17: la API pasa a `api.whetzy.com` (dominio propio en Railway, DNS en
# Cloudflare sin proxy). Con la API en otro dominio registrable la cookie de
# sesión era de terceros y Safari/iOS la tiraba: el registro daba 201 y el
# `/auth/me` siguiente 401 (logs de Railway del 2026-10-16). Mismo sitio, misma
# casa. `api-production-9751.up.railway.app` sigue respondiendo (webhooks, enlaces
# de correo ya enviados).
VITE_API_URL=https://api.whetzy.com/api/v1

# Correo al que abre «Enviar comentario» (Perfil, paso 2 del piloto). Lo decide
# el dueño: sin valor no se pinta el botón. Ejemplo de forma, no de dirección:
# VITE_FEEDBACK_EMAIL=alguien@dominio
