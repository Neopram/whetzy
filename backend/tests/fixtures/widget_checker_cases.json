{
  "_comment": "40.1: casos que corren los dos checkers, backend/app/services/widgets/checkers.py (test_widget_checkers.py) y frontend/src/widgets/checkers.ts (widgetCheckers.test.ts). Si uno cambia sin el otro, su test se pone en rojo. Cada checker necesita al menos un caso true y uno false.",
  "checkers": ["exact", "unordered"],
  "cases": [
    {"checker": "exact", "state": [7, 3, 5], "target": [7, 3, 5], "expected": true, "why": "misma secuencia de sondeos"},
    {"checker": "exact", "state": [7, 5, 3], "target": [7, 3, 5], "expected": false, "why": "el orden importa"},
    {"checker": "exact", "state": {"network": "10.0.0.0", "broadcast": "10.0.0.255"}, "target": {"broadcast": "10.0.0.255", "network": "10.0.0.0"}, "expected": true, "why": "el orden de las claves no importa"},
    {"checker": "exact", "state": {"network": "10.0.0.0"}, "target": {"network": "10.0.0.0", "broadcast": "10.0.0.255"}, "expected": false, "why": "falta una clave"},
    {"checker": "exact", "state": {"network": "10.0.0.0", "broadcast": "10.0.0.255", "x": 1}, "target": {"network": "10.0.0.0", "broadcast": "10.0.0.255"}, "expected": false, "why": "sobra una clave"},
    {"checker": "exact", "state": 1, "target": 1.0, "expected": true, "why": "1 y 1.0 son el mismo número JSON"},
    {"checker": "exact", "state": true, "target": 1, "expected": false, "why": "un booleano no es un número (Python dice True == 1)"},
    {"checker": "exact", "state": [false], "target": [0], "expected": false, "why": "tampoco dentro de una lista"},
    {"checker": "exact", "state": "24", "target": 24, "expected": false, "why": "texto no es número"},
    {"checker": "exact", "state": null, "target": 0, "expected": false, "why": "null no es 0"},
    {"checker": "exact", "state": [], "target": {}, "expected": false, "why": "lista no es objeto"},
    {"checker": "exact", "state": "Ñandú", "target": "Ñandú", "expected": true, "why": "texto no ASCII"},
    {"checker": "exact", "state": " 24", "target": "24", "expected": false, "why": "sin recortes: el widget serializa, no el alumno"},
    {"checker": "unordered", "state": [[1, "Ana"], [2, "Luis"]], "target": [[2, "Luis"], [1, "Ana"]], "expected": true, "why": "las filas de un JOIN en otro orden"},
    {"checker": "unordered", "state": [[1, "Ana"], [1, "Ana"]], "target": [[1, "Ana"], [2, "Luis"]], "expected": false, "why": "las repeticiones cuentan"},
    {"checker": "unordered", "state": [[1, "Ana"]], "target": [[1, "Ana"], [2, "Luis"]], "expected": false, "why": "falta una fila"},
    {"checker": "unordered", "state": [{"id": 1}, {"id": 2}], "target": [{"id": 2}, {"id": 1}], "expected": true, "why": "filas como objetos"},
    {"checker": "unordered", "state": [[2, 1]], "target": [[1, 2]], "expected": false, "why": "el orden dentro de una fila sí importa"},
    {"checker": "unordered", "state": [true], "target": [1], "expected": false, "why": "la misma regla de booleanos"},
    {"checker": "unordered", "state": {"a": 1}, "target": [{"a": 1}], "expected": false, "why": "un objeto no es una lista"},
    {"checker": "unordered", "state": [], "target": [], "expected": true, "why": "un JOIN vacío"}
  ]
}
