# Copy to terraform.tfvars (gitignored) and fill in real values.
# Never commit terraform.tfvars — it contains secrets.

# Railway
railway_token          = "your-railway-api-token"
railway_project_id     = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
railway_environment_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Cloudflare
cloudflare_api_token  = "your-cloudflare-api-token"
cloudflare_account_id = "your-account-id"
cloudflare_zone_id    = "your-zone-id-for-whetzy.com"

# Application secrets
secret_key            = "a-long-random-string-at-least-32-chars"
groq_api_key          = "gsk_..."
stripe_secret_key     = "sk_live_..."
stripe_webhook_secret = "whsec_..."
stripe_price_plus     = "price_..."
content_admin_key     = "a-random-admin-key"
sentry_dsn            = "https://...@sentry.io/..."
vapid_private_key     = ""   # generate with: python -m py_vapid --gen
vapid_public_key      = ""
